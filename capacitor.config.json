{
  "appId": "za.co.sitemargin.app",
  "appName": "SiteMargin",
  "webDir": "dist",
  "backgroundColor": "#F5F5F7",
  "android": {
    "backgroundColor": "#F5F5F7"
  },
  "server": {
    "allowNavigation": [
      "sitemargin.co.za",
      "www.sitemargin.co.za",
      "app.sitemargin.co.za"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0C0C0C",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "SystemBars": {
      "insetsHandling": "disable"
    }
  }
}

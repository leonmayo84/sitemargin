{
  "appId": "za.co.sitemargin.app",
  "appName": "SiteMargin",
  "webDir": "dist",
  "backgroundColor": "#F5EFE2",
  "android": {
    "backgroundColor": "#F5EFE2"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
